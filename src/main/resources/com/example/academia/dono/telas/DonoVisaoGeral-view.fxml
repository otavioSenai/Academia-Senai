<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<ScrollPane fitToWidth="true" styleClass="scroll-pane" stylesheets="@VisaoGeral.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.academia.Dono.Controller.DonoVisaoGeral">
    <VBox spacing="32" maxWidth="1200" alignment="TOP_CENTER" styleClass="root" style="-fx-padding: 32px;">

        <!-- Cabeçalho -->
        <HBox alignment="CENTER_LEFT" spacing="20">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label styleClass="label-sm" text="MÓDULO EXECUTIVO • PAINEL DE CONTROLE CENTRAL" style="-fx-text-fill: #f1ba2a;"/>
                </HBox>
                <Label styleClass="headline-xl" text="Métricas Estratégicas da Unidade"/>
                <Label styleClass="text-muted" text="Visão executiva do Dono: Renda consolidada, corpo técnico e matrículas ativas."/>
            </VBox>
            <Button styleClass="btn-primary" text="Atualizar Painel" onAction="#atualizarDashboard">
                <graphic>
                    <FontIcon iconLiteral="fas-sync-alt" iconSize="14" iconColor="#04070d"/>
                </graphic>
            </Button>
        </HBox>

        <!-- KPI Principal: Balanço Financeiro -->
        <VBox styleClass="card-panel" spacing="16" style="-fx-border-color: #f1ba2a; -fx-border-width: 2px;">
            <HBox alignment="CENTER_LEFT" spacing="8" styleClass="card-header">
                <FontIcon iconLiteral="fas-lock" iconSize="16" iconColor="#f1ba2a"/>
                <Label styleClass="title-md" text="Balanço Financeiro Consolidado" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Label styleClass="badge-warning" style="-fx-background-color: #f1ba2a; -fx-text-fill: #04070d;" text="ACESSO RESTRITO AO PROPRIETÁRIO"/>
            </HBox>

            <GridPane hgap="24" vgap="24">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50"/>
                    <ColumnConstraints percentWidth="50"/>
                </columnConstraints>

                <VBox spacing="8" GridPane.columnIndex="0">
                    <Label styleClass="label-sm" text="RENDA BRUTA TOTAL DOS PLANOS"/>
                    <Label fx:id="lblRendaTotal" styleClass="headline-xl" style="-fx-text-fill: #f1ba2a;" text="R$ 0,00"/>
                    <Label styleClass="text-muted" text="Calculado via GraficoRenda com base nos alunos ativos."/>
                </VBox>

                <VBox spacing="8" GridPane.columnIndex="1">
                    <Label styleClass="label-sm" text="STATUS OPERACIONAL DO GRÁFICO"/>
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <FontIcon iconLiteral="fas-check-circle" iconSize="24" iconColor="#10b981"/>
                        <Label fx:id="lblSituacao" styleClass="headline-lg" text="Ativo"/>
                    </HBox>
                </VBox>
            </GridPane>
        </VBox>

        <!-- Navegação Modular & Métricas -->
        <GridPane hgap="24" vgap="24">
            <columnConstraints>
                <ColumnConstraints percentWidth="33.3"/>
                <ColumnConstraints percentWidth="33.3"/>
                <ColumnConstraints percentWidth="33.3"/>
            </columnConstraints>

            <VBox styleClass="card-panel" spacing="16" GridPane.columnIndex="0">
                <FontIcon iconLiteral="fas-user-graduate" iconSize="24" iconColor="#f1ba2a"/>
                <VBox spacing="4">
                    <Label styleClass="title-md" text="Visualizar Alunos"/>
                    <Label styleClass="text-muted" text="Carteirinhas e métricas"/>
                </VBox>
                <HBox alignment="CENTER_LEFT" spacing="8" styleClass="card-header" style="-fx-border-width: 1 0 0 0; -fx-padding: 12 0 0 0;">
                    <Label fx:id="lblTotalAlunos" styleClass="title-md" text="0"/>
                    <Label styleClass="label-sm" text="Matrículas Ativas"/>
                </HBox>
            </VBox>

            <VBox styleClass="card-panel" spacing="16" GridPane.columnIndex="1">
                <FontIcon iconLiteral="fas-dumbbell" iconSize="24" iconColor="#f1ba2a"/>
                <VBox spacing="4">
                    <Label styleClass="title-md" text="Verificar Equipe Técnica"/>
                    <Label styleClass="text-muted" text="Treinadores e salários"/>
                </VBox>
                <HBox alignment="CENTER_LEFT" spacing="8" styleClass="card-header" style="-fx-border-width: 1 0 0 0; -fx-padding: 12 0 0 0;">
                    <Label fx:id="lblTotalTreinadores" styleClass="title-md" text="0"/>
                    <Label styleClass="label-sm" text="Treinadores CREF"/>
                </HBox>
            </VBox>

            <VBox styleClass="card-panel" spacing="16" GridPane.columnIndex="2">
                <FontIcon iconLiteral="fas-briefcase" iconSize="24" iconColor="#f1ba2a"/>
                <VBox spacing="4">
                    <Label styleClass="title-md" text="Corpo Administrativo"/>
                    <Label styleClass="text-muted" text="Backoffice e recepção"/>
                </VBox>
                <HBox alignment="CENTER_LEFT" spacing="8" styleClass="card-header" style="-fx-border-width: 1 0 0 0; -fx-padding: 12 0 0 0;">
                    <Label fx:id="lblTotalAdms" styleClass="title-md" text="0"/>
                    <Label styleClass="label-sm" text="Funcionários"/>
                </HBox>
            </VBox>
        </GridPane>
    </VBox>
</ScrollPane>
