<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.academia.Dono.Controller.Teste.VisaoGeralController" styleClass="root">

    <!-- Top Bar -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" styleClass="header-bar">
            <Label text="Ícaro Academia" style="-fx-font-size: 16px; -fx-font-weight: bold;" styleClass="text-white" />
            <Button text="+ Cadastrar" styleClass="btn-primary" />
            <TextField promptText="Pesquisar..." style="-fx-background-color: #06090e; -fx-border-color: #0e1116; -fx-text-fill: white; -fx-pref-width: 400px; -fx-border-radius: 6px; -fx-background-radius: 6px;" />
            <Region HBox.hgrow="ALWAYS" />
            <Label text="Kauan - Dono" styleClass="text-gold" />
        </HBox>
    </top>

    <!-- Sidebar Lateral -->
    <left>
        <VBox spacing="10" styleClass="sidebar-panel">
            <BorderPane.margin>
                <Insets top="20" left="20" bottom="20" right="10"/>
            </BorderPane.margin>
            <Label text="NAVEGAÇÃO" styleClass="text-muted" style="-fx-font-size: 10px;"/>
            <Button text="Visão Geral" maxWidth="Infinity" styleClass="nav-button-active" >
                 <graphic>
                    <FontIcon iconLiteral="fas-home" iconSize="18"/>
                 </graphic>
            </Button>
            <Button text="Departamentos" maxWidth="Infinity" styleClass="nav-button" >
                <graphic>
                    <FontIcon iconLiteral="fas-building" iconSize="18"/>
                </graphic>
            </Button>
            <Button text="Planos" maxWidth="Infinity" styleClass="nav-button" >
                <graphic>
                    <FontIcon iconLiteral="fas-clipboard-list" iconSize="18"/>
                </graphic>
            </Button>
            <Button text="Treinador" maxWidth="Infinity" styleClass="nav-button" >
                <graphic>
                    <FontIcon iconLiteral="fas-dumbbell" iconSize="18"/>
                </graphic>
            </Button>
            <Button text="Alunos" maxWidth="Infinity" styleClass="nav-button" >
                <graphic>
                    <FontIcon iconLiteral="fas-users" iconSize="18"/>
                </graphic>
            </Button>
            <Button text="Administrativo" maxWidth="Infinity" styleClass="nav-button" >
                <graphic>
                    <FontIcon iconLiteral="fas-user-tie" iconSize="18"/>
                </graphic>
            </Button>
            <Button text="Gerente" maxWidth="Infinity" styleClass="nav-button" >
                <graphic>
                    <FontIcon iconLiteral="fas-user-cog" iconSize="18"/>
                </graphic>
            </Button>
            <Region VBox.vgrow="ALWAYS" />
            <Button text="Sair do Painel" maxWidth="Infinity" styleClass="nav-button" >
                <graphic>
                    <FontIcon iconLiteral="fas-sign-out-alt" iconSize="18"/>
                </graphic>
            </Button>
        </VBox>
    </left>

    <!-- Conteúdo Central -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-pane">
            <BorderPane.margin>
                <Insets top="20" left="10" bottom="20" right="20"/>
            </BorderPane.margin>
            <VBox spacing="20">

                <!-- Cabeçalho do Conteúdo -->
                <HBox alignment="CENTER_LEFT">
                    <VBox spacing="5">
                        <Label text="Painel de Controle Central" styleClass="text-gold" style="-fx-font-size: 12px;"/>
                        <Label text="Métricas Estratégicas" styleClass="text-white" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                    </VBox>
                </HBox>

                <!-- Sessão Executiva: Balanço Consolidado -->
                <VBox spacing="15" styleClass="card-panel">
                    <Label text="Balanço Consolidado da Unidade" styleClass="text-white" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                    <HBox spacing="15">
                        <VBox styleClass="card-inner" HBox.hgrow="ALWAYS" spacing="5">
                            <Label text="FATURAMENTO BRUTO" styleClass="text-muted" style="-fx-font-size: 11px;"/>
                            <Label fx:id="lblFaturamento" styleClass="text-white" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
                        </VBox>
                        <VBox styleClass="card-inner" HBox.hgrow="ALWAYS" spacing="5">
                            <Label text="FOLHA DE PAGAMENTOS" styleClass="text-muted" style="-fx-font-size: 11px;"/>
                            <Label fx:id="lblFolhaPagamento" styleClass="text-white" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
                        </VBox>
                        <VBox styleClass="card-inner" HBox.hgrow="ALWAYS" spacing="5">
                            <Label text="ALUGUEL + DESPESAS OP." styleClass="text-muted" style="-fx-font-size: 11px;"/>
                            <Label fx:id="lblCustos" styleClass="text-white" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
                        </VBox>
                        <VBox styleClass="card-inner" HBox.hgrow="ALWAYS" spacing="5">
                            <Label text="LUCRO LÍQUIDO REAL" styleClass="text-gold" style="-fx-font-size: 11px; -fx-font-weight: bold;"/>
                            <Label fx:id="lblLucro" styleClass="text-gold" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- Tabela de Últimos Pagamentos -->
                <VBox spacing="10" styleClass="card-panel">
                    <Label text="Últimos Pagamentos" styleClass="text-white" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                    <TableView fx:id="tabelaPagamentos" prefHeight="250">
                        <columns>
                            <TableColumn fx:id="colAluno" text="ALUNO" prefWidth="250" />
                            <TableColumn fx:id="colPlano" text="PLANO" prefWidth="150" />
                            <TableColumn fx:id="colValor" text="VALOR" prefWidth="100" />
                            <TableColumn fx:id="colStatus" text="STATUS" prefWidth="100" />
                            <TableColumn fx:id="colData" text="DATA" prefWidth="150" />
                        </columns>
                    </TableView>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
